# ==============================================================================
# NEXUS-OPS GITIGNORE
# Files, credentials, dependencies, and build artifacts to exclude from GitHub
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Secret Credentials (CRITICAL)
# ------------------------------------------------------------------------------
# Never commit real API keys, Supabase service roles, or database passwords
.env
.env.local
.env.*.local
*.env
backend/.env
frontend/.env

# Always allow committing environment template files
!.env.example
!backend/.env.example
!frontend/.env.example

# SSL certificates and private keys
*.pem
*.key
*.cert
*.crt

# ------------------------------------------------------------------------------
# 2. Dependencies & Package Managers
# ------------------------------------------------------------------------------
node_modules/
*/node_modules/
backend/node_modules/
frontend/node_modules/

# Yarn / pnpm artifacts
.pnp
.pnp.js
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

# ------------------------------------------------------------------------------
# 3. Build Outputs & Compiler Caches
# ------------------------------------------------------------------------------
dist/
dist-ssr/
build/
frontend/dist/
*.local
.vite/
frontend/.vite/
.cache/
.parcel-cache/
.next/
out/
.turbo/

# ------------------------------------------------------------------------------
# 4. Logs & Diagnostic Dumps
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 5. Testing & Browser Automation Caches
# ------------------------------------------------------------------------------
test-results/
playwright-report/
blob-report/
playwright/.cache/
coverage/
.nyc_output/

# ------------------------------------------------------------------------------
# 6. Operating System Artifacts
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ------------------------------------------------------------------------------
# 7. IDE & Text Editor Configuration
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
